{
  "name": "@my-health-app/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "generate:schema": "tsx scripts/generate-schema.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:local": "tsx watch scripts/dev-local.ts",
    "export:sqlite": "tsx scripts/export-sqlite.ts",
    "import:records": "tsx --env-file-if-exists=.env.local scripts/import-records.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@pothos/core": "^4.13.1",
    "@pothos/plugin-zod": "^4.3.1",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.21.3",
    "pg": "^8.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^13.0.3",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
